{
  "description": "ADR-044 preview updates: public GitHub Atom discovery and same-release manifests, shared by the Windows, Linux and macOS hosts.",
  "repository": "o/r",
  "feed": "update-feed.atom",
  "selection": [
    { "name": "preview takes the highest version, compared by number, prerelease included", "platform": "windows", "channel": "preview", "current": "0.1.2", "expected": "windows-v0.1.10" },
    { "name": "stable is refused because Atom has no prerelease flag", "platform": "windows", "channel": "stable", "current": "0.1.2", "expected": null, "error": "metadata_invalid" },
    { "name": "the current version is up to date", "platform": "windows", "channel": "preview", "current": "0.1.10", "expected": null },
    { "name": "a newer local build is never downgraded", "platform": "windows", "channel": "preview", "current": "0.2.1", "expected": null },
    { "name": "other platforms' tags are separate", "platform": "linux", "channel": "preview", "current": "0.1.0", "expected": "linux-v0.1.3" },
    { "name": "macOS reads its own tag prefix", "platform": "macos", "channel": "preview", "current": "0.1.0", "expected": "macos-v0.5.0" },
    { "name": "an absent platform is not reported as up to date", "platform": "android", "channel": "preview", "current": "0.1.0", "expected": null, "error": "metadata_invalid" }
  ],
  "invalidFeeds": [
    "", "{", "<feed>", "<feed />", "<feed xmlns=\"urn:wrong\" />",
    "<!DOCTYPE feed [<!ENTITY x SYSTEM \"file:///etc/passwd\">]><feed xmlns=\"http://www.w3.org/2005/Atom\">&x;</feed>"
  ],
  "manifests": [
    { "name": "a matching manifest names the asset to download",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.10", "tag": "windows-v0.1.10", "summary": "修正與改進",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": { "version": "0.1.10", "summary": "修正與改進", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000,
        "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "url": "https://github.com/o/r/releases/download/windows-v0.1.10/WorkFleet-0.1.10-x64.msix" } },
    { "name": "another platform's manifest is refused",
      "manifest": { "schemaVersion": 1, "platform": "linux", "version": "0.1.10", "tag": "windows-v0.1.10", "summary": "",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null },
    { "name": "a version that differs from the tag is refused",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.11", "tag": "windows-v0.1.10", "summary": "",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null },
    { "name": "a manifest for another release is refused",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.9", "tag": "windows-v0.1.9", "summary": "",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null },
    { "name": "a zero size is refused",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.10", "tag": "windows-v0.1.10", "summary": "",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 0, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null },
    { "name": "a path outside the update folder is refused",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.10", "tag": "windows-v0.1.10", "summary": "",
        "assets": [{ "arch": "x64", "name": "../Other.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null },
    { "name": "no asset for this architecture is refused",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.10", "tag": "windows-v0.1.10", "summary": "",
        "assets": [{ "arch": "arm64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null },
    { "name": "a malformed SHA-256 is refused",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.10", "tag": "windows-v0.1.10", "summary": "",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "AAAA" }] },
      "expected": null },
    { "name": "an unknown schema is refused",
      "manifest": { "schemaVersion": 2, "platform": "windows", "version": "0.1.10", "tag": "windows-v0.1.10", "summary": "",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null }
  ],
  "manifestRelease": "windows-v0.1.10"
}
