// Final public app identity. Personal signing settings and tool paths stay outside Git.
PIN_IT_ANYWHERE_APP_ID = dev.sammykenny2.pinitanywhere
PIN_IT_ANYWHERE_APP_GROUP_ID = group.$(PIN_IT_ANYWHERE_APP_ID)
DEVELOPMENT_TEAM =
// Only the macOS Release app target consumes these; SPM resource bundles must not inherit a profile.
PIN_IT_ANYWHERE_MACOS_SIGNING_STYLE = Automatic
PIN_IT_ANYWHERE_MACOS_SIGNING_IDENTITY = Apple Development
PIN_IT_ANYWHERE_MACOS_PROFILE =
// Apple release version; packages are named from it. Local.xcconfig must not override these.
MARKETING_VERSION = 0.7.1
CURRENT_PROJECT_VERSION = 701
#include? "Local.xcconfig"
