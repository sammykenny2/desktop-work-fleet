{
  // Debug opens the real %LOCALAPPDATA%\PinItAnywhere data; close the installed app first (single owner lock).
  // The apphost .exe keeps the PerMonitorV2 manifest; launching PinItAnywhere.dll through dotnet would drop it.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Windows: Pin It Anywhere (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "windows: build debug",
      "program": "${workspaceFolder}/src/native/windows/app/bin/Debug/net10.0-windows10.0.19041.0/PinItAnywhere.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      "name": "Windows: Pin It Anywhere (Debug + CDP 9339)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "windows: build debug",
      "program": "${workspaceFolder}/src/native/windows/app/bin/Debug/net10.0-windows10.0.19041.0/PinItAnywhere.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": { "PIN_IT_ANYWHERE_WEBVIEW_DEBUG_PORT": "9339" }
    }
  ]
}
