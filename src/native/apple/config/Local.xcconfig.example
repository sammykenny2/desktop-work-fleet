// Copy to Local.xcconfig for personal signing and app identity.
// Replace these examples with your registered Apple identifiers.
WORK_FLEET_APP_ID = app.workfleet.example
WORK_FLEET_APP_GROUP_ID = group.app.workfleet.example
DEVELOPMENT_TEAM = ABCDE12345
