{
  "description": "ADR-043 main window placement rule shared by the Windows, macOS and Linux hosts. Units are each host's own; areas[0] is the primary work area.",
  "defaultSize": { "width": 1180, "height": 800 },
  "cases": [
    { "name": "nothing saved centres the default on the primary work area",
      "saved": null, "areas": [{ "x": 0, "y": 0, "width": 1920, "height": 1040 }],
      "expected": { "x": 370, "y": 120, "width": 1180, "height": 800, "maximized": false } },
    { "name": "bounds inside a work area are kept, maximized included",
      "saved": { "x": 100, "y": 80, "width": 900, "height": 640, "maximized": true }, "areas": [{ "x": 0, "y": 0, "width": 1920, "height": 1040 }],
      "expected": { "x": 100, "y": 80, "width": 900, "height": 640, "maximized": true } },
    { "name": "bounds hanging off a secondary display move back inside it",
      "saved": { "x": 2900, "y": 100, "width": 800, "height": 600, "maximized": false },
      "areas": [{ "x": 0, "y": 0, "width": 1920, "height": 1040 }, { "x": 1920, "y": 0, "width": 1280, "height": 984 }],
      "expected": { "x": 2400, "y": 100, "width": 800, "height": 600, "maximized": false } },
    { "name": "bounds on a disconnected display fall back to the default",
      "saved": { "x": 4000, "y": 200, "width": 900, "height": 700, "maximized": true }, "areas": [{ "x": 0, "y": 0, "width": 1920, "height": 1040 }],
      "expected": { "x": 370, "y": 120, "width": 1180, "height": 800, "maximized": false } },
    { "name": "bounds larger than the work area shrink to fit it",
      "saved": { "x": -50, "y": -20, "width": 1600, "height": 900, "maximized": false }, "areas": [{ "x": 0, "y": 0, "width": 1366, "height": 728 }],
      "expected": { "x": 0, "y": 0, "width": 1366, "height": 728, "maximized": false } },
    { "name": "the default shrinks on a small work area",
      "saved": null, "areas": [{ "x": 0, "y": 0, "width": 1024, "height": 700 }],
      "expected": { "x": 0, "y": 0, "width": 1024, "height": 700, "maximized": false } },
    { "name": "a display left of the primary keeps negative coordinates",
      "saved": { "x": -1000, "y": 50, "width": 900, "height": 700, "maximized": true },
      "areas": [{ "x": 0, "y": 0, "width": 1920, "height": 1040 }, { "x": -1280, "y": 0, "width": 1280, "height": 1000 }],
      "expected": { "x": -1000, "y": 50, "width": 900, "height": 700, "maximized": true } },
    { "name": "bounds across two displays stay on the one they overlap most",
      "saved": { "x": 1500, "y": 100, "width": 1000, "height": 600, "maximized": false },
      "areas": [{ "x": 0, "y": 0, "width": 1920, "height": 1040 }, { "x": 1920, "y": 0, "width": 1280, "height": 984 }],
      "expected": { "x": 1920, "y": 100, "width": 1000, "height": 600, "maximized": false } },
    { "name": "a compositor-placed window keeps only its size, fitted to the primary work area",
      "saved": { "x": null, "y": null, "width": 2000, "height": 900, "maximized": true }, "areas": [{ "x": 0, "y": 0, "width": 1920, "height": 1040 }],
      "expected": { "x": null, "y": null, "width": 1920, "height": 900, "maximized": true } },
    { "name": "an empty size is ignored",
      "saved": { "x": 10, "y": 10, "width": 0, "height": 600, "maximized": false }, "areas": [{ "x": 0, "y": 0, "width": 1920, "height": 1040 }],
      "expected": { "x": 370, "y": 120, "width": 1180, "height": 800, "maximized": false } }
  ]
}
