# Copy to .env; shell/CI environment variables take precedence.
# Build configuration. Do not put access/refresh tokens, passwords, signing keys,
# a Web client secret or service-account JSON here. Empty Google values allow local work.
# The one exception is a Desktop client's secret: Google requires it at the token
# endpoint even with PKCE and treats an installed app's secret as non-confidential,
# so the Windows/Linux app carries it. Only that platform's build receives it.
# Setup and current integration limits: docs/setup-guide.md
# Google Cloud/client registration and platform settings: docs/google-setup.md

# Use one Google Cloud project for all five platforms; enable the Drive API.
WORK_FLEET_GOOGLE_PROJECT_ID=
# Create Desktop app clients for Windows/Linux (the same desktop ID may be reused).
WORK_FLEET_GOOGLE_WINDOWS_CLIENT_ID=
# Google Sign-In Apple SDK uses an iOS-type client matching the macOS bundle ID.
WORK_FLEET_GOOGLE_MACOS_CLIENT_ID=
WORK_FLEET_GOOGLE_LINUX_CLIENT_ID=
# The Desktop client's secret (GOCSPX-...); reuse it when the Linux ID reuses the Windows one.
WORK_FLEET_GOOGLE_WINDOWS_CLIENT_SECRET=
WORK_FLEET_GOOGLE_LINUX_CLIENT_SECRET=
# Create an iOS client matching the final bundle ID.
WORK_FLEET_GOOGLE_IOS_CLIENT_ID=
# Android client registration must match package name and signing certificate.
WORK_FLEET_GOOGLE_ANDROID_CLIENT_ID=
# Web client in the same project: Android Credential Manager ID-token audience.
# No client secret or backend is used; AuthorizationClient grants Drive separately.
WORK_FLEET_GOOGLE_WEB_CLIENT_ID=

# Final native bundle/package identifier; leave empty until chosen.
# Direct Xcode builds use src/native/apple/config/Local.xcconfig for app ID,
# App Group and Team; these .env identity values apply to the Apple CLI wrapper.
# Dotted segments start with a letter and contain only letters/digits (Apple/Android intersection).
WORK_FLEET_APP_ID=
# Public Apple development team identifier. Signing keys stay in the OS/CI keychain.
WORK_FLEET_APPLE_TEAM_ID=
# iOS app + Share Extension App Group; empty derives group.<WORK_FLEET_APP_ID>.
# Register this group and enable App Groups on both Apple signing profiles.
WORK_FLEET_APP_GROUP_ID=

# Microsoft Store identity from Partner Center, or your own sideload identity.
# Publisher must exactly match the signing certificate's subject; these are public.
WORK_FLEET_WINDOWS_PACKAGE_ID=
WORK_FLEET_WINDOWS_PUBLISHER=
WORK_FLEET_WINDOWS_PUBLISHER_DISPLAY_NAME=

# Public release/contact URLs. Publish the supplied privacy text at your own URL.
# Android signing is process/CI-only: WORK_FLEET_ANDROID_KEYSTORE (absolute path),
# WORK_FLEET_ANDROID_KEY_ALIAS, WORK_FLEET_ANDROID_STORE_PASSWORD,
# WORK_FLEET_ANDROID_KEY_PASSWORD. Do not put these secrets in this file or .env.
# Build with -Signed / --signed to require a signed release AAB.
WORK_FLEET_PRIVACY_URL=
WORK_FLEET_SUPPORT_URL=
WORK_FLEET_SUPPORT_EMAIL=

# Optional SDK locations. Omit these lines if already configured by the OS/CI.
# ANDROID_HOME=C:/path/to/Android/Sdk
# JAVA_HOME=C:/path/to/jdk-17
# GRADLE_HOME=C:/path/to/gradle-8.13
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer

# In-app updates (ADR-044) read GitHub Releases of this public owner/repo; empty uses sammykenny2/desktop-work-fleet.
WORK_FLEET_UPDATE_REPOSITORY=
# Only the preview channel exists so far.
WORK_FLEET_UPDATE_CHANNEL=
# macOS updates (Sparkle): the base64 public key printed by Sparkle's generate_keys on the maintainer's Mac.
# Without it the macOS app shows its version but no update check. The private key stays in that Mac's keychain or a CI secret.
WORK_FLEET_SPARKLE_PUBLIC_KEY=
