  "selection": [
    { "name": "preview takes the highest version, compared by number, prerelease included", "platform": "windows", "channel": "preview", "current": "0.1.2", "expected": "windows-v0.1.10" },
    { "name": "stable leaves prereleases out", "platform": "windows", "channel": "stable", "current": "0.1.2", "expected": "windows-v0.1.9" },
    { "name": "the current version is up to date", "platform": "windows", "channel": "preview", "current": "0.1.10", "expected": null },
    { "name": "a newer local build is never downgraded", "platform": "windows", "channel": "preview", "current": "0.2.1", "expected": null },
    { "name": "other platforms' tags are separate", "platform": "linux", "channel": "preview", "current": "0.1.0", "expected": "linux-v0.1.3" },
    { "name": "macOS reads its own tag prefix", "platform": "macos", "channel": "stable", "current": "0.1.0", "expected": "macos-v0.5.0" }
  ],
  "manifests": [
    { "name": "a matching manifest names the asset to download",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.10", "tag": "windows-v0.1.10", "summary": "修正與改進",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
