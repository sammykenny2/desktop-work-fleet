{
  "description": "ADR-044 preview updates: public GitHub Atom discovery of the one vX.Y.Z release that carries every platform, and each platform's manifest in it, shared by the Windows, Linux and macOS hosts. Per-platform tags such as windows-vX.Y.Z belong to releases before 0.3.7 and are ignored.",
  "repository": "o/r",
  "feed": "update-feed.atom",
  "selection": [
    { "name": "preview takes the highest vX.Y.Z version, compared by number, prerelease included; higher per-platform tags are ignored", "channel": "preview", "current": "0.1.2", "expected": "v0.1.10" },
    { "name": "stable is refused because Atom has no prerelease flag", "channel": "stable", "current": "0.1.2", "expected": null, "error": "metadata_invalid" },
    { "name": "the current version is up to date", "channel": "preview", "current": "0.1.10", "expected": null },
    { "name": "a newer local build is never downgraded", "channel": "preview", "current": "0.2.1", "expected": null }
  ],
  "withoutRelease": "<feed xmlns=\"http://www.w3.org/2005/Atom\"><entry><link href=\"https://github.com/o/r/releases/tag/windows-v0.5.0\" /></entry></feed>",
  "manifestNames": { "windows": "work-fleet-update-windows.json", "linux": "work-fleet-update-linux.json", "macos": "work-fleet-update-macos.json" },
  "invalidFeeds": [
    "", "{", "<feed>", "<feed />", "<feed xmlns=\"urn:wrong\" />",
    "<!DOCTYPE feed [<!ENTITY x SYSTEM \"file:///etc/passwd\">]><feed xmlns=\"http://www.w3.org/2005/Atom\">&x;</feed>"
  ],
  "manifests": [
    { "name": "a matching manifest names the asset to download",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.10", "tag": "v0.1.10", "summary": "Fixes and improvements",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": { "version": "0.1.10", "summary": "Fixes and improvements", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000,
        "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "url": "https://github.com/o/r/releases/download/v0.1.10/WorkFleet-0.1.10-x64.msix" } },
    { "name": "another platform's manifest is refused",
      "manifest": { "schemaVersion": 1, "platform": "linux", "version": "0.1.10", "tag": "v0.1.10", "summary": "",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null },
    { "name": "a version that differs from the tag is refused",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.11", "tag": "v0.1.10", "summary": "",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null },
    { "name": "a manifest for another release is refused",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.9", "tag": "v0.1.9", "summary": "",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null },
    { "name": "a zero size is refused",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.10", "tag": "v0.1.10", "summary": "",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 0, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null },
    { "name": "a path outside the update folder is refused",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.10", "tag": "v0.1.10", "summary": "",
        "assets": [{ "arch": "x64", "name": "../Other.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null },
    { "name": "no asset for this architecture is refused",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.10", "tag": "v0.1.10", "summary": "",
        "assets": [{ "arch": "arm64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null },
    { "name": "a malformed SHA-256 is refused",
      "manifest": { "schemaVersion": 1, "platform": "windows", "version": "0.1.10", "tag": "v0.1.10", "summary": "",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "AAAA" }] },
      "expected": null },
    { "name": "an unknown schema is refused",
      "manifest": { "schemaVersion": 2, "platform": "windows", "version": "0.1.10", "tag": "v0.1.10", "summary": "",
        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 1000, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null }
  ],
  "manifestRelease": "v0.1.10"
}
