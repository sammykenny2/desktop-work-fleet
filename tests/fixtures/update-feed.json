        "assets": [{ "arch": "x64", "name": "WorkFleet-0.1.10-x64.msix", "size": 999, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
      "expected": null },
    { "name": "an asset the release does not carry is refused",
